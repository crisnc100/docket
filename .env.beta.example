# Settings for the hosted beta (compose.prod.yaml). Copy to .env.beta on the host, fill in
# every blank and every placeholder, and keep it mode 600. Never commit .env.beta.
# Make the random values with: openssl rand -hex 32
# A blank value stops docker compose; a placeholder left in stops Docket at startup.

# The site's own origin. Every POST must come from it.
DOCKET_BASE_URL=https://docket.cristianortega.dev
# The API listens on 127.0.0.1 at this port, for Caddy only.
DOCKET_PORT=8001

# Invite codes, comma-separated, each at least 16 characters. Removing one signs out
# everyone who used it.
DOCKET_INVITE_CODES=replace-with-invite-code-one,replace-with-invite-code-two
# Signs the session cookie: at least 32 bytes. Changing it signs everyone out.
DOCKET_SESSION_KEY=

# Caddy appends the client address to X-Forwarded-For, so Docket reads its last hop.
DOCKET_TRUST_PROXY=1

# A beta-only Anthropic key, with a monthly spend limit set at the provider too. Only the
# worker receives it.
ANTHROPIC_API_KEY=
DOCKET_MODEL_MODE=live
# The most all live answers together may cost per UTC day, in USD. At most 1.00.
DOCKET_DAILY_BUDGET_USD=1.00
# Held documents wait a day for review, so the queue seeded at 08:00 UTC lasts until the
# next reset.
DOCKET_REVIEW_TIMEOUT_SECONDS=86400

# Letters and digits only.
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
