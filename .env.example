DATABASE_URL=postgresql+psycopg://docket:docket@localhost:55432/docket  # pragma: allowlist secret
TEMPORAL_ADDRESS=localhost:7233
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=docket-local
S3_SECRET_KEY=docket-local-password # pragma: allowlist secret
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# For live Anthropic answers: DOCKET_MODEL_PROVIDER=anthropic and DOCKET_MODEL=claude-haiku-5-5.
DOCKET_MODEL_PROVIDER=openrouter
DOCKET_MODEL=openai/gpt-4o-mini
DOCKET_PROVIDER=OpenAI
DOCKET_DAILY_BUDGET_USD=1.50
S3_BUCKET=docket
DOCKET_TASK_QUEUE=docket
DOCKET_MODEL_MODE=replay
# Empty uses the provider's own archive: evals/recordings/anthropic.jsonl or calls.jsonl.
DOCKET_REPLAY_PATH=
DOCKET_REVIEW_TIMEOUT_SECONDS=3600
DOCKET_RUN_BUDGET_USD=2.00
# An evaluation refuses a --budget above this cap.
DOCKET_RUN_BUDGET_CAP_USD=5.00
DOCKET_WEBHOOK_SECRET=
DOCKET_WEBHOOK_RATE_LIMIT=60
DOCKET_REVIEW_TOKEN=
